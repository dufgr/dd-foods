# Local PostgreSQL started with `docker compose up -d`.
DATABASE_URL="postgresql://dd_foods:dd_foods_local@localhost:5432/dd_foods?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-unique-secret-for-your-environment"

# Enables one-click mock sign-in in development only; ignored in production.
NEXT_PUBLIC_LOCAL_AUTH_ENABLED="true"

# Optional for local development; required for Google sign-in in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
